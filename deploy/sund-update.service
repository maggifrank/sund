# Pulls and restarts Sund if the repo has moved. Triggered by sund-update.timer.
# Installed by deploy/install-updater.sh — re-run that after changing this file.
[Unit]
Description=Update Sund from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The installed copy, root-owned and outside the checkout, so a push cannot
# change what root runs. Never point this back at /opt/sund/deploy/.
ExecStart=/usr/local/sbin/sund-update
Environment=SUND_REPO=/opt/sund
Environment=SUND_URL=http://127.0.0.1:8080
# Root only to call systemctl and to drop to sund-build with runuser; every git
# command runs as sund-build, which owns the checkout.
User=root
# Root's failed-revision mark lives here, never in the checkout.
StateDirectory=sund-update
StateDirectoryMode=0700
# sund.service runs as a different user and must still read what git writes.
UMask=0022
PrivateTmp=true
ProtectHome=true
